{
  "version": "0.1",
  "tools": [
    {
      "name": "get_dataset_schema",
      "description": "Return fields, geometry type, and spatial reference for an allowed dataset.",
      "side_effect": "none",
      "requires_approval": false,
      "input_schema": {
        "type": "object",
        "required": ["dataset"],
        "properties": {
          "dataset": {
            "type": "string",
            "enum": ["roads", "slope", "admin_areas"]
          }
        },
        "additionalProperties": false
      },
      "output_schema": {
        "type": "object",
        "required": ["dataset", "geometry_type", "crs", "fields"],
        "properties": {
          "dataset": {"type": "string"},
          "geometry_type": {"type": "string"},
          "crs": {"type": "string"},
          "fields": {"type": "array"}
        }
      }
    },
    {
      "name": "range_query",
      "description": "Filter an allowed dataset by a bounding box and structured attribute conditions.",
      "side_effect": "none",
      "requires_approval": false,
      "input_schema": {
        "type": "object",
        "required": ["dataset", "conditions", "limit"],
        "properties": {
          "dataset": {
            "type": "string",
            "enum": ["roads", "slope", "admin_areas"]
          },
          "bbox": {
            "type": "array",
            "minItems": 4,
            "maxItems": 4,
            "items": {"type": "number"}
          },
          "conditions": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["field", "operator", "value"],
              "properties": {
                "field": {"type": "string"},
                "operator": {
                  "type": "string",
                  "enum": ["eq", "neq", "gt", "gte", "lt", "lte", "in"]
                },
                "value": {}
              },
              "additionalProperties": false
            }
          },
          "limit": {
            "type": "integer",
            "minimum": 1,
            "maximum": 10000
          }
        },
        "additionalProperties": false
      },
      "output_schema": {
        "type": "object",
        "required": ["result_ref", "count", "crs"],
        "properties": {
          "result_ref": {"type": "string"},
          "count": {"type": "integer"},
          "crs": {"type": "string"}
        }
      }
    },
    {
      "name": "spatial_join",
      "description": "Join two allowed datasets using a supported spatial relation.",
      "side_effect": "none",
      "requires_approval": false,
      "input_schema": {
        "type": "object",
        "required": ["left_dataset", "right_dataset", "relation"],
        "properties": {
          "left_dataset": {
            "type": "string",
            "enum": ["roads", "slope", "admin_areas"]
          },
          "right_dataset": {
            "type": "string",
            "enum": ["roads", "slope", "admin_areas"]
          },
          "relation": {
            "type": "string",
            "enum": ["intersects", "contains", "within", "near"]
          },
          "distance_m": {
            "type": "number",
            "minimum": 0,
            "maximum": 10000
          }
        },
        "additionalProperties": false
      },
      "output_schema": {
        "type": "object",
        "required": ["result_ref", "count", "left_dataset", "right_dataset"],
        "properties": {
          "result_ref": {"type": "string"},
          "count": {"type": "integer"},
          "left_dataset": {"type": "string"},
          "right_dataset": {"type": "string"}
        }
      }
    },
    {
      "name": "get_raster_metadata",
      "description": "Return lightweight metadata for an allowed raster dataset without reading raster arrays.",
      "side_effect": "none",
      "requires_approval": false,
      "input_schema": {
        "type": "object",
        "required": ["dataset"],
        "properties": {
          "dataset": {
            "type": "string",
            "enum": ["dem", "land_use"]
          },
          "max_files": {
            "type": "integer",
            "minimum": 1,
            "maximum": 10
          }
        },
        "additionalProperties": false
      },
      "output_schema": {
        "type": "object",
        "required": ["dataset", "file_count", "sample_files", "metadata"],
        "properties": {
          "dataset": {"type": "string"},
          "file_count": {"type": "integer"},
          "sample_files": {"type": "array"},
          "metadata": {"type": "object"}
        }
      }
    }
  ]
}
