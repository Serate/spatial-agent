{
  "version": "0.2",
  "tools": [
    {
      "name": "get_dataset_schema",
      "description": "Return fields, geometry type, and spatial reference for an allowed dataset.",
      "side_effect": "none",
      "requires_approval": false,
      "timeout_seconds": 10,
      "permissions": ["spatial_data:read"],
      "data_dependencies": ["$dataset"],
      "input_schema": {
        "type": "object",
        "required": ["dataset"],
        "properties": {
          "dataset": {
            "type": "string",
            "minLength": 1,
            "maxLength": 96
          }
        },
        "additionalProperties": false
      },
      "output_schema": {
        "type": "object",
        "required": ["dataset", "geometry_type", "crs", "fields"],
        "properties": {
          "dataset": {"type": "string"},
          "geometry_type": {"type": "string"},
          "crs": {"type": "string"},
          "fields": {"type": "array"}
        }
      }
    },
    {
      "name": "range_query",
      "description": "Filter an allowed dataset by a bounding box and structured attribute conditions.",
      "side_effect": "none",
      "requires_approval": false,
      "timeout_seconds": 20,
      "permissions": ["spatial_data:read"],
      "data_dependencies": ["$dataset"],
      "input_schema": {
        "type": "object",
        "required": ["dataset", "conditions", "limit"],
        "properties": {
          "dataset": {
            "type": "string",
            "minLength": 1,
            "maxLength": 96
          },
          "bbox": {
            "type": "array",
            "minItems": 4,
            "maxItems": 4,
            "items": {"type": "number"}
          },
          "conditions": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["field", "operator", "value"],
              "properties": {
                "field": {"type": "string"},
                "operator": {
                  "type": "string",
                  "enum": ["eq", "neq", "gt", "gte", "lt", "lte", "in"]
                },
                "value": {}
              },
              "additionalProperties": false
            }
          },
          "limit": {
            "type": "integer",
            "minimum": 1,
            "maximum": 10000
          }
        },
        "additionalProperties": false
      },
      "output_schema": {
        "type": "object",
        "required": ["result_ref", "count", "crs"],
        "properties": {
          "result_ref": {"type": "string"},
          "count": {"type": "integer"},
          "crs": {"type": "string"}
        }
      }
    },
    {
      "name": "record_analysis",
      "description": "Analyze bounded records from an allowed vector dataset using filter, aggregate, timeseries, or compare semantics.",
      "side_effect": "none",
      "requires_approval": false,
      "timeout_seconds": 30,
      "permissions": ["spatial_data:read"],
      "data_dependencies": ["$dataset"],
      "input_schema": {
        "type": "object",
        "required": ["dataset", "operation"],
        "properties": {
          "dataset": {
            "type": "string",
            "minLength": 1,
            "maxLength": 96
          },
          "operation": {
            "type": "string",
            "enum": ["filter", "aggregate", "timeseries", "compare"]
          },
          "filters": {
            "type": "array",
            "maxItems": 32,
            "items": {
              "type": "object",
              "required": ["field", "operator", "value"],
              "properties": {
                "field": {"type": "string", "minLength": 1, "maxLength": 96},
                "operator": {
                  "type": "string",
                  "enum": ["eq", "neq", "gt", "gte", "lt", "lte", "in"]
                },
                "value": {}
              },
              "additionalProperties": false
            }
          },
          "group_by": {
            "type": "array",
            "maxItems": 8,
            "items": {"type": "string", "minLength": 1, "maxLength": 96}
          },
          "aggregations": {
            "type": "array",
            "maxItems": 8,
            "items": {
              "type": "object",
              "required": ["function", "alias"],
              "properties": {
                "function": {"type": "string", "enum": ["count", "sum", "mean", "min", "max"]},
                "field": {"type": ["string", "null"], "maxLength": 96},
                "alias": {"type": "string", "minLength": 1, "maxLength": 96}
              },
              "additionalProperties": false
            }
          },
          "time_field": {"type": ["string", "null"], "maxLength": 96},
          "limit": {"type": "integer", "minimum": 1, "maximum": 10000}
        },
        "additionalProperties": false
      },
      "output_schema": {
        "type": "object",
        "required": ["schema_version", "status", "result_type", "dataset", "rows", "metrics", "data_profile"],
        "properties": {
          "schema_version": {"type": "string"},
          "status": {"type": "string", "enum": ["ready", "degraded", "unavailable"]},
          "result_type": {"type": "string", "const": "record_analysis_result"},
          "dataset": {"type": "string"},
          "rows": {"type": "array"},
          "metrics": {"type": "object"},
          "data_profile": {"type": "object"},
          "provenance": {"type": "object"},
          "warnings": {"type": "array"}
        }
      }
    },
    {
      "name": "spatial_join",
      "description": "Join two allowed datasets using a supported spatial relation.",
      "side_effect": "none",
      "requires_approval": false,
      "timeout_seconds": 30,
      "permissions": ["spatial_data:read"],
      "data_dependencies": ["$left_dataset", "$right_dataset"],
      "input_schema": {
        "type": "object",
        "required": ["left_dataset", "right_dataset", "relation"],
        "properties": {
          "left_dataset": {
            "type": "string",
            "enum": ["roads", "water", "slope", "admin_areas"]
          },
          "right_dataset": {
            "type": "string",
            "enum": ["roads", "water", "slope", "admin_areas"]
          },
          "relation": {
            "type": "string",
            "enum": ["intersects", "contains", "within", "near"]
          },
          "distance_m": {
            "type": "number",
            "minimum": 0,
            "maximum": 10000
          }
        },
        "additionalProperties": false
      },
      "output_schema": {
        "type": "object",
        "required": ["result_ref", "count", "left_dataset", "right_dataset"],
        "properties": {
          "result_ref": {"type": "string"},
          "count": {"type": "integer"},
          "left_dataset": {"type": "string"},
          "right_dataset": {"type": "string"}
        }
      }
    },
    {
      "name": "spatial_operation",
      "description": "Apply a bounded vector geometry operation to a configured dataset or a previous vector result.",
      "side_effect": "none",
      "requires_approval": false,
      "timeout_seconds": 60,
      "permissions": ["spatial_data:read"],
      "data_dependencies": ["$input_ref", "$mask_ref"],
      "input_schema": {
        "type": "object",
        "required": ["operation", "input_ref", "mask_ref"],
        "properties": {
          "operation": {
            "type": "string",
            "enum": ["clip", "intersect", "buffer", "distance"]
          },
          "input_ref": {
            "type": "string",
            "maxLength": 256,
            "description": "Configured vector dataset ID or a previous result_ref."
          },
          "mask_ref": {
            "type": "string",
            "maxLength": 256,
            "description": "Configured vector dataset ID or a previous result_ref."
          },
          "max_features": {
            "type": "integer",
            "minimum": 1,
            "maximum": 10000
          },
          "distance_m": {
            "type": "number",
            "minimum": 0,
            "maximum": 100000
          }
        },
        "additionalProperties": false
      },
      "output_schema": {
        "type": "object",
        "required": ["result_ref", "operation", "input_ref", "mask_ref", "count", "crs"],
        "properties": {
          "result_ref": {"type": "string"},
          "operation": {"type": "string", "enum": ["clip", "intersect", "buffer", "distance"]},
          "input_ref": {"type": "string"},
          "mask_ref": {"type": "string"},
          "count": {"type": "integer"},
          "crs": {"type": ["string", "null"]},
          "data_profile": {"type": "object"},
          "summary": {"type": "object"},
          "metrics": {"type": "object"}
        }
      }
    },
    {
      "name": "get_raster_metadata",
      "description": "Return lightweight metadata for an allowed raster dataset without reading raster arrays.",
      "side_effect": "none",
      "requires_approval": false,
      "timeout_seconds": 20,
      "permissions": ["spatial_data:read"],
      "data_dependencies": ["$dataset"],
      "input_schema": {
        "type": "object",
        "required": ["dataset"],
        "properties": {
          "dataset": {
            "type": "string",
            "enum": ["dem", "land_use"]
          },
          "max_files": {
            "type": "integer",
            "minimum": 1,
            "maximum": 10
          }
        },
        "additionalProperties": false
      },
      "output_schema": {
        "type": "object",
        "required": ["dataset", "file_count", "sample_files", "metadata"],
        "properties": {
          "dataset": {"type": "string"},
          "file_count": {"type": "integer"},
          "sample_files": {"type": "array"},
          "metadata": {"type": "object"}
        }
      }
    },
    {
      "name": "get_raster_statistics",
      "description": "Compute bounded streaming statistics for an allowed raster dataset.",
      "side_effect": "none",
      "requires_approval": false,
      "timeout_seconds": 60,
      "permissions": ["spatial_data:read"],
      "data_dependencies": ["$dataset"],
      "input_schema": {
        "type": "object",
        "required": ["dataset"],
        "properties": {
          "dataset": {
            "type": "string",
            "enum": ["dem", "land_use"]
          },
          "max_files": {
            "type": "integer",
            "minimum": 1,
            "maximum": 10
          }
        },
        "additionalProperties": false
      },
      "output_schema": {
        "type": "object",
        "required": ["dataset", "file_count", "statistics"],
        "properties": {
          "dataset": {"type": "string"},
          "file_count": {"type": "integer"},
          "statistics": {"type": "object"}
        }
      }
    },
    {
      "name": "get_zonal_raster_statistics",
      "description": "Compute raster statistics inside a named administrative area with CRS-aware masking.",
      "side_effect": "none",
      "requires_approval": false,
      "timeout_seconds": 90,
      "permissions": ["spatial_data:read"],
      "data_dependencies": ["admin_areas", "$dataset"],
      "input_schema": {
        "type": "object",
        "required": ["dataset", "admin_name"],
        "properties": {
          "dataset": {
            "type": "string",
            "enum": ["dem", "land_use"]
          },
          "admin_name": {"type": "string", "minLength": 2},
          "max_files": {
            "type": "integer",
            "minimum": 1,
            "maximum": 10
          }
        },
        "additionalProperties": false
      },
      "output_schema": {
        "type": "object",
        "required": ["dataset", "admin_name", "statistics"],
        "properties": {
          "dataset": {"type": "string"},
          "admin_name": {"type": "string"},
          "statistics": {"type": "object"}
        }
      }
    },
    {
      "name": "get_zonal_slope_statistics",
      "description": "Derive slope in degrees from the real DEM and summarize it inside a named administrative area.",
      "side_effect": "none",
      "requires_approval": false,
      "timeout_seconds": 120,
      "permissions": ["spatial_data:read"],
      "data_dependencies": ["admin_areas", "dem"],
      "input_schema": {
        "type": "object",
        "required": ["admin_name"],
        "properties": {
          "admin_name": {"type": "string", "minLength": 2},
          "max_files": {"type": "integer", "minimum": 1, "maximum": 10}
        },
        "additionalProperties": false
      },
      "output_schema": {
        "type": "object",
        "required": ["dataset", "admin_name", "statistics"],
        "properties": {"dataset": {"type": "string"}, "admin_name": {"type": "string"}, "statistics": {"type": "object"}}
      }
    },
    {
      "name": "get_zonal_land_use_distribution",
      "description": "Count land-use raster classes and their shares inside a named administrative area.",
      "side_effect": "none",
      "requires_approval": false,
      "timeout_seconds": 120,
      "permissions": ["spatial_data:read"],
      "data_dependencies": ["admin_areas", "land_use"],
      "input_schema": {
        "type": "object",
        "required": ["admin_name"],
        "properties": {
          "admin_name": {"type": "string", "minLength": 2},
          "max_files": {"type": "integer", "minimum": 1, "maximum": 10}
        },
        "additionalProperties": false
      },
      "output_schema": {
        "type": "object",
        "required": ["dataset", "admin_name", "statistics"],
        "properties": {"dataset": {"type": "string"}, "admin_name": {"type": "string"}, "statistics": {"type": "object"}}
      }
    },
    {
      "name": "get_zonal_buildability_analysis",
      "description": "Run an auditable demo screening of construction candidate pixels using DEM-derived slope and land-use classes.",
      "side_effect": "none",
      "requires_approval": false,
      "timeout_seconds": 180,
      "permissions": ["spatial_data:read"],
      "data_dependencies": ["admin_areas", "dem", "land_use"],
      "input_schema": {
        "type": "object",
        "required": ["admin_name"],
        "properties": {
          "admin_name": {"type": "string", "minLength": 2},
          "max_files": {"type": "integer", "minimum": 1, "maximum": 10},
          "slope_limit_degrees": {"type": "number", "minimum": 1, "maximum": 45}
        },
        "additionalProperties": false
      },
      "output_schema": {
        "type": "object",
        "required": ["dataset", "admin_name", "statistics", "rules"],
        "properties": {"dataset": {"type": "string"}, "admin_name": {"type": "string"}, "statistics": {"type": "object"}, "rules": {"type": "object"}}
      }
    },
    {
      "name": "get_zonal_vector_summary",
      "description": "Summarize clipped OSM roads or water features inside a named administrative area.",
      "side_effect": "none",
      "requires_approval": false,
      "timeout_seconds": 90,
      "permissions": ["spatial_data:read"],
      "data_dependencies": ["admin_areas", "$dataset"],
      "input_schema": {
        "type": "object",
        "required": ["dataset", "admin_name"],
        "properties": {
          "dataset": {"type": "string", "enum": ["roads", "water"]},
          "admin_name": {"type": "string", "minLength": 2},
          "max_features": {"type": "integer", "minimum": 1, "maximum": 10000}
        },
        "additionalProperties": false
      },
      "output_schema": {
        "type": "object",
        "required": ["dataset", "admin_name", "summary", "result_ref"],
        "properties": {
          "dataset": {"type": "string"},
          "admin_name": {"type": "string"},
          "summary": {"type": "object"},
          "result_ref": {"type": "string"}
        }
      }
    },
    {
      "name": "get_zonal_constrained_buildability_analysis",
      "description": "Apply auditable demo constraints from slope, land-use candidates, road distance, and water exclusion inside an administrative area.",
      "side_effect": "none",
      "requires_approval": false,
      "timeout_seconds": 240,
      "permissions": ["spatial_data:read"],
      "data_dependencies": ["admin_areas", "dem", "land_use", "roads", "water"],
      "input_schema": {
        "type": "object",
        "required": ["admin_name"],
        "properties": {
          "admin_name": {"type": "string", "minLength": 2},
          "slope_limit_degrees": {"type": "number", "minimum": 1, "maximum": 45},
          "road_distance_m": {"type": "number", "minimum": 0, "maximum": 10000},
          "exclude_water": {"type": "boolean"},
          "max_files": {"type": "integer", "minimum": 1, "maximum": 10}
        },
        "additionalProperties": false
      },
      "output_schema": {
        "type": "object",
        "required": ["dataset", "admin_name", "statistics"],
        "properties": {
          "dataset": {"type": "string"},
          "admin_name": {"type": "string"},
          "statistics": {"type": "object"},
          "constraint_summary": {"type": "object"},
          "result_ref": {"type": "string"}
        }
      }
    },
    {
      "name": "get_dataset_health_report",
      "description": "Check bounded readability, CRS, coverage, and basic geometry quality for configured spatial datasets.",
      "side_effect": "none",
      "requires_approval": false,
      "timeout_seconds": 60,
      "permissions": ["spatial_data:read"],
      "data_dependencies": ["admin_areas", "dem", "land_use", "roads", "water"],
      "input_schema": {
        "type": "object",
        "required": [],
        "properties": {
          "dataset": {
            "type": "string",
            "enum": ["all", "admin_areas", "dem", "land_use", "roads", "water"]
          },
          "max_files": {"type": "integer", "minimum": 1, "maximum": 10}
        },
        "additionalProperties": false
      },
      "output_schema": {
        "type": "object",
        "required": ["dataset", "status", "datasets"],
        "properties": {
          "dataset": {"type": "string"},
          "status": {"type": "string", "enum": ["ready", "degraded", "unavailable"]},
          "datasets": {"type": "array"},
          "capabilities": {"type": "object"},
          "relationships": {"type": "object"},
          "warning": {"type": "string"}
        }
      }
    }
  ]
}
