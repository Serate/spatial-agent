{
  "goal": "build a cross-source spatial overview for an administrative area",
  "steps": [
    {
      "id": "dataset-health",
      "tool": "get_dataset_health_report",
      "args": {
        "dataset": "all",
        "max_files": 10
      },
      "depends_on": []
    },
    {
      "id": "schema-admin",
      "tool": "get_dataset_schema",
      "args": {
        "dataset": "admin_areas"
      },
      "depends_on": ["dataset-health"]
    },
    {
      "id": "filter-admin",
      "tool": "range_query",
      "args": {
        "dataset": "admin_areas",
        "conditions": [
          {
            "field": "name",
            "operator": "eq",
            "value": "洪山区"
          }
        ],
        "limit": 100
      },
      "depends_on": ["schema-admin"]
    },
    {
      "id": "overview-elevation",
      "tool": "get_zonal_raster_statistics",
      "args": {
        "dataset": "dem",
        "admin_name": {
          "$from": "filter-admin",
          "path": "first_name"
        },
        "max_files": 10
      },
      "depends_on": ["filter-admin"]
    },
    {
      "id": "overview-slope",
      "tool": "get_zonal_slope_statistics",
      "args": {
        "admin_name": {
          "$from": "filter-admin",
          "path": "first_name"
        },
        "max_files": 10
      },
      "depends_on": ["filter-admin"]
    },
    {
      "id": "overview-land-use",
      "tool": "get_zonal_land_use_distribution",
      "args": {
        "admin_name": {
          "$from": "filter-admin",
          "path": "first_name"
        },
        "max_files": 10
      },
      "depends_on": ["filter-admin"]
    },
    {
      "id": "overview-roads",
      "tool": "get_zonal_vector_summary",
      "args": {
        "dataset": "roads",
        "admin_name": {
          "$from": "filter-admin",
          "path": "first_name"
        },
        "max_features": 10000
      },
      "depends_on": ["filter-admin"]
    },
    {
      "id": "overview-water",
      "tool": "get_zonal_vector_summary",
      "args": {
        "dataset": "water",
        "admin_name": {
          "$from": "filter-admin",
          "path": "first_name"
        },
        "max_features": 10000
      },
      "depends_on": ["filter-admin"]
    }
  ],
  "output": {
    "type": "spatial_overview_result",
    "summary": true
  }
}
