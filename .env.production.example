# Copy to .env.production and fill secrets. Do not commit the copied file.
OPENAI_API_KEY=
OPENAI_BASE_URL=
OPENAI_MODEL=
OPENAI_WIRE_API=responses
OPENAI_TIMEOUT_SECONDS=45
OPENAI_MAX_RETRIES=1
OPENAI_MAX_OUTPUT_TOKENS=2048
OPENAI_STRUCTURED_OUTPUT_MODE=json_object
# Answer generation is a separate, latency-oriented provider call.
OPENAI_ANSWER_TIMEOUT_SECONDS=20
OPENAI_ANSWER_MAX_RETRIES=0
OPENAI_ANSWER_MAX_OUTPUT_TOKENS=768
SPATIAL_AGENT_DEFAULT_PLANNER=openai
SPATIAL_AGENT_DEFAULT_BACKEND=local
SPATIAL_AGENT_REACT_MODE=full
SPATIAL_AGENT_WEB_SEARCH_ENABLED=1
SPATIAL_AGENT_WEB_MODE=allowlist
SPATIAL_AGENT_WEB_SEARCH_TIMEOUT_SECONDS=8
SPATIAL_AGENT_WEB_SEARCH_MAX_RESPONSE_BYTES=2097152
SPATIAL_AGENT_WEB_SEARCH_MAX_SOURCES=8
SPATIAL_AGENT_WEB_FETCH_TIMEOUT_SECONDS=10
SPATIAL_AGENT_WEB_FETCH_MAX_RESPONSE_BYTES=4194304
SPATIAL_AGENT_WEB_FETCH_MAX_MODEL_CHARS=24000
# Optional proxy settings for the main service. The tool-proposal sandbox remains offline.
# HTTP_PROXY=http://proxy.example:8080
# HTTPS_PROXY=http://proxy.example:8080
# NO_PROXY=127.0.0.1,localhost
SPATIAL_AGENT_TOOL_PROPOSALS_ENABLED=1
SPATIAL_AGENT_REACT_MAX_TURNS=8
SPATIAL_AGENT_REACT_MAX_ACTIONS=12
SPATIAL_AGENT_ASYNC_WORKERS=4
